{
    "name": "recman-api",
    "version": "1.0.0",
    "description": "RecMan API - Recipe and sales management backend (Express + TypeScript + TypeORM + PostgreSQL)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/data-source.ts",
        "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/data-source.ts",
        "seed": "ts-node src/scripts/seed.ts"
    },
    "dependencies": {
        "axios": "^1.7.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-async-errors": "^3.1.1",
        "firebase-admin": "^12.0.0",
        "jose": "^5.2.4",
        "node-cache": "^5.1.2",
        "pg": "^8.13.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.20",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^22.7.4",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.6.3"
    }
}